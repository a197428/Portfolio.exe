{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-exe",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-14",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
